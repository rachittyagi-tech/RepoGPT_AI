# =========================================================
# RepoGPT AI — Development environment (Step 14)
# Copy to ".env" for `docker compose up` (docker-compose.yml) or local
# `uvicorn --reload` runs. See .env.example for the full variable reference
# with explanations of every setting.
# =========================================================

APP_NAME=RepoGPT AI
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=dev-secret-not-for-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
LOG_JSON=false
LOG_LEVEL=DEBUG

POSTGRES_USER=repogpt
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=repogpt_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://repogpt:devpassword@db:5432/repogpt_db

REDIS_URL=redis://localhost:6379/0

REPOSITORY_STORAGE_PATH=data/repositories

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNK_MAX_CHUNKS_PER_FILE=500
CHUNK_MAX_CHUNKS_PER_REPOSITORY=50000

EMBEDDING_PROVIDER=huggingface
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EMBEDDING_MODEL=text-embedding-004
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2
BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
TIMEOUT=30

CHROMA_PERSIST_DIR=data/chroma_db
COLLECTION_NAME_PREFIX=repogpt_
CHROMA_DISTANCE_METRIC=cosine
DEFAULT_TOP_K=5
MAX_TOP_K=50
DEFAULT_SCORE_THRESHOLD=0.0
BATCH_UPSERT_SIZE=200

RAG_TOP_K=5
RAG_MAX_TOP_K=20
RAG_MIN_SIMILARITY_THRESHOLD=0.3
RAG_MIN_QUERY_LENGTH=3
RAG_MAX_QUERY_LENGTH=500
RAG_HYBRID_SEMANTIC_WEIGHT=0.7
RAG_HYBRID_KEYWORD_WEIGHT=0.3
RAG_MAX_CHARS_PER_CHUNK=1500
RAG_MAX_CONTEXT_TOKENS=4000
RAG_MAX_CONVERSATION_TOKENS=800

GEMINI_MODEL=gemini-1.5-flash
MAX_OUTPUT_TOKENS=2048
TEMPERATURE=0.3
TOP_P=0.95
TOP_K=40
REQUEST_TIMEOUT=60
GEMINI_CHAT_MAX_RETRIES=2

JWT_SECRET_KEY=dev-jwt-secret-not-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# frontend/.env.example uses its own VITE_API_BASE_URL for the Vite dev
# server (http://127.0.0.1:8000); this one is only read if the frontend
# container loads this same root .env file.
VITE_API_BASE_URL=http://localhost:8000

SENTRY_DSN=
