# =========================================================
# RepoGPT AI — Environment Variable Template (Step 14)
# Copy this file to ".env" (local dev) and fill in real values.
# NEVER commit the actual ".env", ".env.development", or ".env.production" file.
#
# For Docker Compose dev/prod, use the more specific templates instead:
#   .env.development.example  -> copy to .env  (used by docker-compose.yml)
#   .env.production.example   -> copy to .env.production (used by docker-compose.prod.yml)
# This file documents every variable the app reads; the other two are
# leaner, environment-specific starting points.
# =========================================================

# ---------- App ----------
APP_NAME=RepoGPT AI
APP_VERSION=1.0.0
APP_ENV=development                 # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-long-random-string

# CORS: comma-separated exact origins the frontend is served from. Never
# "*" in production — see app/core/config.py (CORS_CONFIG) / app/core/settings.py.
# (Step 14 doc note: this is the same setting some infra docs call CORS_ORIGINS.)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Public URLs (Step 14) — used for cross-service links, not for CORS itself.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Structured JSON logs — set true in production for log-aggregator ingestion
# (see app/core/logging.py's JSONFormatter). Human-readable text in dev.
LOG_JSON=false
LOG_LEVEL=INFO

# ---------- Database (PostgreSQL) ----------
POSTGRES_USER=repogpt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=repogpt_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Must stay in sync with the POSTGRES_* values above — asyncpg driver, used
# by app/database/database.py's async engine and by Alembic (alembic/env.py).
DATABASE_URL=postgresql+asyncpg://repogpt:change-me@db:5432/repogpt_db

# ---------- Redis ----------
# Reserved for future use (rate limiting / caching / a real task queue).
# Nothing in the current codebase connects to Redis yet — there is no
# `docker-compose` redis service by default; add one back if/when this is
# actually wired up.
REDIS_URL=redis://localhost:6379/0

# ---------- Storage (Step 14) ----------
# Where cloned repositories are written (app/core/constants.py). In Docker,
# this is a mounted volume path — see docker-compose.prod.yml.
REPOSITORY_STORAGE_PATH=data/repositories

# ---------- Code Processing Pipeline (Step 5) ----------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNK_MAX_CHUNKS_PER_FILE=500
CHUNK_MAX_CHUNKS_PER_REPOSITORY=50000

# ---------- Embedding Generation Layer (Step 6) ----------
EMBEDDING_PROVIDER=huggingface       # huggingface | gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EMBEDDING_MODEL=text-embedding-004
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2
BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
TIMEOUT=30

# ---------- ChromaDB Vector Store (Step 7) ----------
# Embedded/PersistentClient mode (app/database/chromadb_client.py) — this
# is a local directory, NOT a host:port for a separate ChromaDB server.
CHROMA_PERSIST_DIR=data/chroma_db
COLLECTION_NAME_PREFIX=repogpt_
CHROMA_DISTANCE_METRIC=cosine
DEFAULT_TOP_K=5
MAX_TOP_K=50
DEFAULT_SCORE_THRESHOLD=0.0
BATCH_UPSERT_SIZE=200

# ---------- RAG Pipeline (Step 8) ----------
RAG_TOP_K=5
RAG_MAX_TOP_K=20
RAG_MIN_SIMILARITY_THRESHOLD=0.3
RAG_MIN_QUERY_LENGTH=3
RAG_MAX_QUERY_LENGTH=500
RAG_HYBRID_SEMANTIC_WEIGHT=0.7
RAG_HYBRID_KEYWORD_WEIGHT=0.3
RAG_MAX_CHARS_PER_CHUNK=1500
RAG_MAX_CONTEXT_TOKENS=4000
RAG_MAX_CONVERSATION_TOKENS=800

# ---------- AI Chat Engine (Step 9) ----------
# GEMINI_API_KEY is already set above (Step 6) — reused here for chat generation.
GEMINI_MODEL=gemini-1.5-flash
MAX_OUTPUT_TOKENS=2048
TEMPERATURE=0.3
TOP_P=0.95
TOP_K=40
REQUEST_TIMEOUT=60
GEMINI_CHAT_MAX_RETRIES=2

# ---------- GitHub Integration ----------
# Only public HTTPS repository cloning is implemented (Step 3). These OAuth
# values are reserved for a future private-repo/OAuth login feature and are
# not read by any current code path.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# ---------- Auth (JWT — Step 11) ----------
JWT_SECRET_KEY=change-this-too
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Frontend (Vite — must be prefixed VITE_ to reach the browser bundle) ----------
# Empty string = same-origin relative requests (correct when Nginx proxies
# /api/ to the backend, e.g. docker-compose.prod.yml). Set to the backend's
# full URL only when frontend and backend are on different origins
# (e.g. Vercel + Render — see README's "Deployment" section, Option A).
VITE_API_BASE_URL=http://127.0.0.1:8000

# ---------- Observability ----------
SENTRY_DSN=
