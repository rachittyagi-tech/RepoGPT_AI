# =========================================================
# RepoGPT AI — Production environment (Step 14)
# Copy to ".env.production" for `docker compose -f docker-compose.prod.yml`.
#
# EVERY value below marked CHANGE-ME must be replaced with a real secret
# before deploying. Generate strong random secrets, e.g.:
#   openssl rand -hex 32
# =========================================================

APP_NAME=RepoGPT AI
APP_VERSION=1.0.0
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32

# Exact production origin(s) only — never "*" (see app/core/config.py).
ALLOWED_ORIGINS=https://your-production-domain.com
FRONTEND_URL=https://your-production-domain.com
BACKEND_URL=https://your-production-domain.com

# Structured JSON logs for your log aggregator (see app/core/logging.py).
LOG_JSON=true
LOG_LEVEL=INFO

POSTGRES_USER=repogpt
POSTGRES_PASSWORD=CHANGE-ME-strong-random-password
POSTGRES_DB=repogpt_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://repogpt:CHANGE-ME-strong-random-password@db:5432/repogpt_db

REDIS_URL=redis://localhost:6379/0

REPOSITORY_STORAGE_PATH=data/repositories

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNK_MAX_CHUNKS_PER_FILE=500
CHUNK_MAX_CHUNKS_PER_REPOSITORY=50000

EMBEDDING_PROVIDER=huggingface
GEMINI_API_KEY=CHANGE-ME-your-real-gemini-api-key
GEMINI_EMBEDDING_MODEL=text-embedding-004
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2
BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
TIMEOUT=30

CHROMA_PERSIST_DIR=data/chroma_db
COLLECTION_NAME_PREFIX=repogpt_
CHROMA_DISTANCE_METRIC=cosine
DEFAULT_TOP_K=5
MAX_TOP_K=50
DEFAULT_SCORE_THRESHOLD=0.0
BATCH_UPSERT_SIZE=200

RAG_TOP_K=5
RAG_MAX_TOP_K=20
RAG_MIN_SIMILARITY_THRESHOLD=0.3
RAG_MIN_QUERY_LENGTH=3
RAG_MAX_QUERY_LENGTH=500
RAG_HYBRID_SEMANTIC_WEIGHT=0.7
RAG_HYBRID_KEYWORD_WEIGHT=0.3
RAG_MAX_CHARS_PER_CHUNK=1500
RAG_MAX_CONTEXT_TOKENS=4000
RAG_MAX_CONVERSATION_TOKENS=800

GEMINI_MODEL=gemini-1.5-flash
MAX_OUTPUT_TOKENS=2048
TEMPERATURE=0.3
TOP_P=0.95
TOP_K=40
REQUEST_TIMEOUT=60
GEMINI_CHAT_MAX_RETRIES=2

JWT_SECRET_KEY=CHANGE-ME-generate-a-different-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Gunicorn worker count for the backend container (see backend/Dockerfile).
# Rule of thumb: (2 x CPU cores) + 1, capped by available memory.
WEB_CONCURRENCY=2

# Empty = same-origin relative requests, correct for the default
# docker-compose.prod.yml topology where Nginx proxies /api/ to the
# backend on the SAME origin as the frontend. Only set this to a full URL
# if frontend and backend are deployed to different origins (Option A —
# see README's Deployment section). NOTE: unlike the other variables here,
# this one is a Docker *build* arg (see frontend/Dockerfile), not a
# container runtime env var — set it in docker-compose.prod.yml's
# `frontend.build.args`, not by editing this file alone.
VITE_API_BASE_URL=

SENTRY_DSN=
